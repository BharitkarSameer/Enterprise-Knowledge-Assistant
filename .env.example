# Copy to .env and fill in your key. Never commit .env.

GEMINI_API_KEY=your_gemini_api_key_here
# New AI Studio keys often cannot use gemini-2.5-flash (404 "no longer available
# to new users"). Prefer a current model, e.g. gemini-3-flash-preview or
# gemini-3.1-flash-lite / gemini-flash-lite-latest.
GEMINI_MODEL=gemini-3-flash-preview

# Free-tier request caps (typical Flash limits). TPM is rarely the bottleneck.
GEMINI_RPM=5
GEMINI_RPD=20

# Optional: reduces Hugging Face download rate-limit warnings for local embedding/rerank models.
# HF_TOKEN=
